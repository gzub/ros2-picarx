<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="picarx_bot">

    <!-- Properties -->
    <xacro:property name="body_length" value=".22" />
    <xacro:property name="body_width" value="0.085" />
    <xacro:property name="body_height" value="0.04" />
    <xacro:property name="body_mass" value="20.3" />
    <xacro:property name="front_wheel_width" value=".025" />
    <xacro:property name="front_wheel_diameter" value="0.065" />
    <xacro:property name="rear_wheel_width" value=".025" />
    <xacro:property name="rear_wheel_diameter" value="0.065" />
    <xacro:property name="base_link_z" value="${rear_wheel_diameter/2}" />

    <!-- Materials -->
    <material name="Blue">
        <color rgba="0 0 1 1" />
    </material>
    <material name="Red">
        <color rgba="1 0 0 1" />
    </material>
    <material name="Green">
        <color rgba="0 1 0 1" />
    </material>
    <material name="Yellow">
        <color rgba="1 1 0 1" />
    </material>
    <material name="Gray">
        <color rgba="0.5 0.5 0.5 1" />
    </material>
    <material name="Black">
        <color rgba="0 0 0 1" />
    </material>
    <material name="Orange">
        <color rgba="1 0.5 0 1" />
    </material>

    <!-- Base Link -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 ${base_link_z + body_height/2}" rpy="0 0 0" />
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}" />
            </geometry>
            <material name="Orange" />
        </visual>
        <collision>
            <origin xyz="0 0 ${base_link_z + body_height/2}" rpy="0 0 0" />
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}" />
            </geometry>
        </collision>
    </link>

    <!-- Steering Link (Ackermann) -->
    <link name="steering_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.02 0.07 0.01" />
            </geometry>
            <material name="Gray" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.02 0.07 0.01" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2" />
            <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
        </inertial>
    </link>
    <joint name="steering_joint" type="revolute">
        <parent link="base_link" />
        <child link="steering_link" />
        <origin xyz="0.035 0 ${base_link_z}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-0.5" upper="0.5" effort="1" velocity="3" />
    </joint>

    <!-- Additional Steering Joints for Compatibility -->
    <link name="left_steering_link"/>
    <link name="right_steering_link"/>
    <joint name="left_steering_joint" type="revolute">
        <parent link="steering_link"/>
        <child link="left_steering_link"/>
        <origin xyz="0 0.03 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="0.0" effort="1" velocity="1"/>
    </joint>
    <joint name="right_steering_joint" type="revolute">
        <parent link="steering_link"/>
        <child link="right_steering_link"/>
        <origin xyz="0 -0.03 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="0.0" effort="1" velocity="1"/>
    </joint>

    <!-- Front Wheels (fixed to steering link) -->
    <link name="left_front_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${front_wheel_width}" radius="${front_wheel_diameter/2}" />
            </geometry>
            <material name="Green" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${front_wheel_width}" radius="${front_wheel_diameter/2}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2" />
            <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
        </inertial>
    </link>
    <link name="right_front_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${front_wheel_width}" radius="${front_wheel_diameter/2}" />
            </geometry>
            <material name="Red" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${front_wheel_width}" radius="${front_wheel_diameter/2}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2" />
            <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
        </inertial>
    </link>
    <joint name="left_front_wheel_joint" type="fixed">
        <parent link="left_steering_link" />
        <child link="left_front_wheel" />
        <origin xyz="0 0.015 0" rpy="0 0 0" />
    </joint>
    <joint name="right_front_wheel_joint" type="fixed">
        <parent link="right_steering_link" />
        <child link="right_front_wheel" />
        <origin xyz="0 -0.015 0" rpy="0 0 0" />
    </joint>

    <!-- Rear Wheels (driven, continuous) -->
    <link name="left_rear_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${rear_wheel_width}" radius="${rear_wheel_diameter/2}" />
            </geometry>
            <material name="Yellow" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${rear_wheel_width}" radius="${rear_wheel_diameter/2}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.5" />
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>
    </link>
    <link name="right_rear_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${rear_wheel_width}" radius="${rear_wheel_diameter/2}" />
            </geometry>
            <material name="Yellow" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${rear_wheel_width}" radius="${rear_wheel_diameter/2}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.5" />
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>
    </link>
    <joint name="left_rear_axle" type="continuous">
        <parent link="base_link" />
        <child link="left_rear_wheel" />
        <origin xyz="-0.065 0.045 ${base_link_z}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    <joint name="right_rear_axle" type="continuous">
        <parent link="base_link" />
        <child link="right_rear_wheel" />
        <origin xyz="-0.065 -0.045 ${base_link_z}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- Ultrasonic Sensor -->
    <link name="ultrasonic_link">
        <visual>
            <origin xyz="0.01 0 -${base_link_z-body_height/2}" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.01"/>
            </geometry>
            <material name="Blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 -${base_link_z-body_height/2}" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.01"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
        </inertial>
    </link>
    <joint name="ultrasonic_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_link"/>
        <origin xyz="${body_length/2 - 0.005} 0 ${base_link_z + body_height}" rpy="0 0 0"/>
    </joint>

    <!-- ros2_control block -->
    <ros2_control name="picarx_system" type="system">
        <hardware>
            <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
            <param name="joint_commands_topic">/topic_based_joint_commands</param>
            <param name="joint_states_topic">/topic_based_joint_states</param>
        </hardware>
        <joint name="steering_joint">
            <command_interface name="position" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
        <joint name="left_steering_joint">
            <command_interface name="position" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
        <joint name="right_steering_joint">
            <command_interface name="position" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
        <joint name="left_rear_axle">
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="position" />
            <command_interface name="velocity" />
        </joint>
        <joint name="right_rear_axle">
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="position" />
            <command_interface name="velocity" />
        </joint>
    </ros2_control>
</robot>