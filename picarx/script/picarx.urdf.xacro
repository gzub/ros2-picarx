<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="picarx_bot">

    <!-- =================== Properties =================== -->
    <!-- General properties of the robot -->
    <xacro:property name="body_length" value=".22" />
    <xacro:property name="body_width" value="0.085" />
    <xacro:property name="body_height" value="0.04" />
    <xacro:property name="body_mass" value="20.3" />
    <xacro:property name="front_wheel_width" value=".025" />
    <xacro:property name="front_wheel_diameter" value="0.065" />
    <xacro:property name="rear_wheel_width" value=".025" />
    <xacro:property name="rear_wheel_diameter" value="0.065" />
    <xacro:property name="base_link_z" value="${rear_wheel_diameter/2}" />

    <!-- =================== Materials ==================== -->
    <!-- Define the materials used in the robot -->
    <material name="Blue">
        <color rgba="0 0 1 1" />
    </material>
    <material name="Red">
        <color rgba="1 0 0 1" />
    </material>
    <material name="Green">
        <color rgba="0 1 0 1" />
    </material>
    <material name="Yellow">
        <color rgba="1 1 0 1" />
    </material>
    <material name="Gray">
        <color rgba="0.5 0.5 0.5 1" />
    </material>
    <material name="Black">
        <color rgba="0 0 0 1" />
    </material>
    <material name="Orange">
        <color rgba="1 0.5 0 1" />
    </material>

    <!-- =================== Base ========================= -->
    <!-- Add odom link and fixed joint for TF root -->
    <link name="odom" />
    <joint name="odom_base_link" type="fixed">
        <parent link="odom" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- Base link of the robot -->
    <link name="base_link">
    </link>
    <link name="chassis_link">
        <visual>
            <origin xyz="0 0 ${base_link_z + body_height/2}" rpy="0 0 0" />
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}" />
            </geometry>
            <material name="Orange" />
        </visual>
        <collision>
            <origin xyz="0 0 ${base_link_z + body_height/2}" rpy="0 0 0" />
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="base_chassis_joint" type="fixed">
        <parent link="base_link" />
        <child link="chassis_link" />
        <origin xyz="0 0 0" rpy="0 0 0 " />
    </joint>

    <!-- =================== Steering ===================== -->
    <!-- Additional Steering Joints for Compatibility -->
    <link name="left_steering_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.01" radius="0.01" />
            </geometry>
            <material name="Gray" />
        </visual>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.01" />
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
        </inertial>
    </link>
    <link name="right_steering_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.01" radius="0.01" />
            </geometry>
            <material name="Gray" />
        </visual>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.01" />
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
        </inertial>
    </link>
    <joint name="left_steering_joint" type="revolute">
        <parent link="base_link" />
        <child link="left_steering_link" />
        <origin xyz="0.035 0.03 ${base_link_z}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-0.56" upper="0.56" effort="10" velocity="7.5" />
    </joint>
    <joint name="right_steering_joint" type="revolute">
        <parent link="base_link" />
        <child link="right_steering_link" />
        <origin xyz="0.035 -0.03 ${base_link_z}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-0.56" upper="0.56" effort="10" velocity="7.5" />
    </joint>

    <!-- =================== Wheels ======================= -->
    <!-- Define the wheels of the robot -->
    <!-- Front Wheels (fixed to steering link) -->
    <link name="left_front_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${front_wheel_width}" radius="${front_wheel_diameter/2}" />
            </geometry>
            <material name="Green" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${front_wheel_width}" radius="${front_wheel_diameter/2}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2" />
            <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
        </inertial>
    </link>
    <link name="right_front_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${front_wheel_width}" radius="${front_wheel_diameter/2}" />
            </geometry>
            <material name="Red" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${front_wheel_width}" radius="${front_wheel_diameter/2}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2" />
            <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
        </inertial>
    </link>
    <joint name="left_front_wheel_joint" type="fixed">
        <parent link="left_steering_link" />
        <child link="left_front_wheel" />
        <origin xyz="0 0.015 0" rpy="0 0 0" />
    </joint>
    <joint name="right_front_wheel_joint" type="fixed">
        <parent link="right_steering_link" />
        <child link="right_front_wheel" />
        <origin xyz="0 -0.015 0" rpy="0 0 0" />
    </joint>

    <!-- Rear Wheels (driven, continuous) -->
    <link name="left_rear_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${rear_wheel_width}" radius="${rear_wheel_diameter/2}" />
            </geometry>
            <material name="Yellow" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${rear_wheel_width}" radius="${rear_wheel_diameter/2}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.5" />
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>
    </link>
    <link name="right_rear_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${rear_wheel_width}" radius="${rear_wheel_diameter/2}" />
            </geometry>
            <material name="Yellow" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${rear_wheel_width}" radius="${rear_wheel_diameter/2}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.5" />
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>
    </link>
    <joint name="left_rear_axle" type="continuous">
        <parent link="base_link" />
        <child link="left_rear_wheel" />
        <origin xyz="-0.065 0.045 ${base_link_z}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    <joint name="right_rear_axle" type="continuous">
        <parent link="base_link" />
        <child link="right_rear_wheel" />
        <origin xyz="-0.065 -0.045 ${base_link_z}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- =================== Sensors ====================== -->
    <!-- Define the sensors on the robot -->

    <!-- IMU Sensor -->
    <link name="imu_link">
        <visual>
            <origin xyz="0 0 ${base_link_z + body_height/2}" rpy="0 0 0" />
            <geometry>
                <box size="0.025 0.025 0.015" />
            </geometry>
            <material name="Blue" />
        </visual>
        <collision>
            <origin xyz="0 0 ${base_link_z + body_height/2}" rpy="0 0 0" />
            <geometry>
                <box size="0.025 0.025 0.015" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.01" />
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
        </inertial>
    </link>
    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="0 0 ${base_link_z + body_height/2}" rpy="0 0 0" />
    </joint>

    <!-- Ultrasonic Sensor -->
    <link name="ultrasonic_link">
        <visual>
            <origin xyz="0.01 0 -${base_link_z-body_height/2}" rpy="0 1.5708 0" />
            <geometry>
                <cylinder length="0.01" radius="0.01" />
            </geometry>
            <material name="Blue" />
        </visual>
        <collision>
            <origin xyz="0.01 0 -${base_link_z-body_height/2}" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.01" radius="0.01" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.01" />
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
        </inertial>
    </link>
    <joint name="ultrasonic_joint" type="fixed">
        <parent link="base_link" />
        <child link="ultrasonic_link" />
        <origin xyz="${body_length/2 - 0.005} 0 ${base_link_z + body_height}" rpy="0 0 0" />
    </joint>

    <!-- =================== Camera Pan-Tilt ============== -->
    <!-- Define the camera and its pan-tilt mechanism -->
    <link name="camera_pan_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.02" radius="0.015" />
            </geometry>
            <material name="Gray" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.02" radius="0.015" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.02" />
            <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002" />
        </inertial>
    </link>
    <joint name="camera_pan_joint" type="revolute">
        <parent link="base_link" />
        <child link="camera_pan_link" />
        <origin xyz="${body_length/2} 0 ${base_link_z + body_height}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-1.5708" upper="1.5708" effort="1" velocity="1" />
    </joint>

    <link name="camera_tilt_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.02" radius="0.015" />
            </geometry>
            <material name="Gray" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.02" radius="0.015" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.02" />
            <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002" />
        </inertial>
    </link>
    <joint name="camera_tilt_joint" type="revolute">
        <parent link="camera_pan_link" />
        <child link="camera_tilt_link" />
        <origin xyz="0 0 0.02" rpy="0 0 0" />
        <axis xyz="0 -1 0" />
        <limit lower="-1.5708" upper="1.5708" effort="1" velocity="1" />
    </joint>

    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 1.5708 0" />
            <geometry>
                <box size="0.03 0.03 0.03" />
            </geometry>
            <material name="Black" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 1.5708 0" />
            <geometry>
                <box size="0.03 0.03 0.03" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.05" />
            <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" />
        </inertial>
    </link>
    <joint name="camera_link_joint" type="fixed">
        <parent link="camera_tilt_link" />
        <child link="camera_link" />
        <origin xyz="0 0 0.02" rpy="0 0 0" />
    </joint>

    <!-- Static transforms for RViz2 visualization (for pan/tilt/camera) -->
    <!-- Remove gazebo_ros_planar_move plugins, as they are not needed for RViz2 TF tree and may
    cause confusion -->

    <!-- =================== ros2_control ================= -->
    <!-- ros2_control configuration for the robot -->
    <ros2_control name="picarx_system" type="system">
        <hardware>
            <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        </hardware>
        <joint name="left_steering_joint">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>
        <joint name="right_steering_joint">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>
        <joint name="left_rear_axle">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>
        <joint name="right_rear_axle">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>
    </ros2_control>

    <!-- =================== Transmissions ================= -->
    <!-- Required for ros2_control to map joints to actuators -->
    <transmission name="left_steering_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="left_steering_joint">
            <hardwareInterface>position</hardwareInterface>
        </joint>
        <actuator name="left_steering_motor">
            <hardwareInterface>position</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="right_steering_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="right_steering_joint">
            <hardwareInterface>position</hardwareInterface>
        </joint>
        <actuator name="right_steering_motor">
            <hardwareInterface>position</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="left_rear_axle_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="left_rear_axle">
            <hardwareInterface>velocity</hardwareInterface>
        </joint>
        <actuator name="left_rear_motor">
            <hardwareInterface>velocity</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="right_rear_axle_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="right_rear_axle">
            <hardwareInterface>velocity</hardwareInterface>
        </joint>
        <actuator name="right_rear_motor">
            <hardwareInterface>velocity</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <!-- =================== Grayscale Sensors ============ -->
    <!-- Three TCRT5000-based grayscale sensors at the front of the chassis, facing down -->
    <link name="grayscale_0_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.01" radius="0.005" />
            </geometry>
            <material name="Black" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.01" radius="0.005" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.001" />
            <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
        </inertial>
    </link>
    <link name="grayscale_1_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.01" radius="0.005" />
            </geometry>
            <material name="Black" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.01" radius="0.005" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.001" />
            <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
        </inertial>
    </link>
    <link name="grayscale_2_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.01" radius="0.005" />
            </geometry>
            <material name="Black" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.01" radius="0.005" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.001" />
            <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
        </inertial>
    </link>
    <joint name="grayscale_0_joint" type="fixed">
        <parent link="base_link" />
        <!-- Slightly left, at the front, just below the chassis, facing down -->
        <child link="grayscale_0_link" />
        <origin xyz="${body_length/2} 0.015 ${base_link_z + 0.005}" rpy="0 1.5708 0" />
    </joint>
    <joint name="grayscale_1_joint" type="fixed">
        <parent link="base_link" />
        <!-- Centered, at the front, just below the chassis, facing down -->
        <child link="grayscale_1_link" />
        <origin xyz="${body_length/2} 0.0 ${base_link_z + 0.005}" rpy="0 1.5708 0" />
    </joint>
    <joint name="grayscale_2_joint" type="fixed">
        <parent link="base_link" />
        <!-- Slightly right, at the front, just below the chassis, facing down -->
        <child link="grayscale_2_link" />
        <origin xyz="${body_length/2} -0.015 ${base_link_z + 0.005}" rpy="0 1.5708 0" />
    </joint>
</robot>