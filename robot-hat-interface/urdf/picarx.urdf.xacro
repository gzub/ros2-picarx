<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_hat_robot">

  <!-- Included URDF Files -->
  <xacro:include filename="inertial_macros.xacro" />

  <!-- Namespace Property -->
  <xacro:property name="namespace" value="robot_hat_interface"/>

  <!-- Constants -->
  <xacro:property name="wheel_radius" value="0.033" />
  <xacro:property name="wheel_width" value="0.026" />
  <xacro:property name="chassis_length" value="0.15" />
  <xacro:property name="chassis_width" value="0.1" />
  <xacro:property name="chassis_height" value="0.05" />
  <xacro:property name="servo_link_length" value="0.05" />

  <!-- Chassis -->
  <link name="${namespace}/base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <!-- Left Wheel -->
  <link name="${namespace}/left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <joint name="${namespace}/left_wheel_joint" type="continuous">
    <parent link="${namespace}/base_link"/>
    <child link="${namespace}/left_wheel"/>
    <origin xyz="0 ${chassis_width/2 + wheel_width/2} ${-chassis_height/2}" rpy="0 1.5707 1.5707"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Wheel -->
  <link name="${namespace}/right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <joint name="${namespace}/right_wheel_joint" type="continuous">
    <parent link="${namespace}/base_link"/>
    <child link="${namespace}/right_wheel"/>
    <origin xyz="0 ${-chassis_width/2 - wheel_width/2} ${-chassis_height/2}" rpy="0 1.5707 1.5707"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Steering Servo Link -->
  <link name="${namespace}/steering_servo_link">
    <visual>
      <geometry>
        <box size="${servo_link_length} 0.02 0.02"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${servo_link_length} 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0"
               iyy="0.00005" iyz="0.0"
               izz="0.00005"/>
    </inertial>
  </link>

  <joint name="${namespace}/steering_servo_joint" type="revolute">
    <parent link="${namespace}/base_link"/>
    <child link="${namespace}/steering_servo_link"/>
    <origin xyz="${chassis_length/2} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
  </joint>

  <!-- ROS2 Control Tag -->
  <ros2_control name="RobotHatHardware" type="system">
    <hardware>
      <plugin>robot_hat_interface/RobotHatHardware</plugin>
    </hardware>
    <joint name="${namespace}/left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${namespace}/right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${namespace}/steering_servo_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
