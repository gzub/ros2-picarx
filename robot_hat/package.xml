<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_hat</name>
  <version>0.0.1</version>
  <description>Robot Hat Python library for Raspberry Pi.</description>

  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>GPLv3</license>

  <exec_depend>python3</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <exec_depend>python3-gpiozero</exec_depend>
  <exec_depend>python3-rpi-lgpio</exec_depend>
  <exec_depend>python3-pyaudio</exec_depend>
  <exec_depend>python3-spidev</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-pygame</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
